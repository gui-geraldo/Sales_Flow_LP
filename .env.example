# Copie para .env.local e preencha com os IDs reais.
# Nenhuma dessas variáveis deve ir pro git (.env.local já está no .gitignore).

# Google Analytics 4 — Admin > Fluxos de dados > ID da métrica (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads — Ferramentas > Conversões > ID de conversão (formato AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Meta Pixel — Gerenciador de Eventos > ID do pixel (só números)
NEXT_PUBLIC_META_PIXEL_ID=

# Preço e link de checkout por moeda. Sem valor definido, mostra "---" como
# placeholder (com aviso na página) e o botão cai de volta pro scroll ao #cta.
# BRL: Brasil · EUR: Espanha e Portugal · USD: resto do mundo (incl. América Latina hispânica)
NEXT_PUBLIC_PRICE_BRL=R$ 497
NEXT_PUBLIC_CHECKOUT_URL_BRL=

NEXT_PUBLIC_PRICE_EUR=
NEXT_PUBLIC_CHECKOUT_URL_EUR=

NEXT_PUBLIC_PRICE_USD=
NEXT_PUBLIC_CHECKOUT_URL_USD=
