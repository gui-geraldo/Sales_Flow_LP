# Copie para .env.local e preencha com os IDs reais.
# Nenhuma dessas variáveis deve ir pro git (.env.local já está no .gitignore).

# Google Analytics 4 — Admin > Fluxos de dados > ID da métrica (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads — Ferramentas > Conversões > ID de conversão (formato AW-XXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Label de cada ação de conversão (Conversões > ação > Configuração da tag,
# a parte depois da barra em send_to: 'AW-XXXXXXXXX/<label>').
# Formulário enviado = lead (já abre o WhatsApp). Conversão principal.
NEXT_PUBLIC_GOOGLE_ADS_FORM_LABEL=
# Formulário aberto (clique em qualquer botão de contato). Opcional, usar como secundária.
NEXT_PUBLIC_GOOGLE_ADS_FORM_OPEN_LABEL=
# Compra não sai daqui: a LP não tem checkout. Vem de onde o pagamento acontece.

# Meta Pixel — Gerenciador de Eventos > ID do pixel (só números)
NEXT_PUBLIC_META_PIXEL_ID=

# Preço por moeda. Pode ser só o número ("149"): o símbolo entra no código.
# Vazio = padrão do código (R$ 497 · € 149 · US$ 149). Os links de checkout
# não são usados hoje: todos os botões abrem o formulário antes do WhatsApp.
# BRL: Brasil · EUR: Espanha e Portugal · USD: resto do mundo (incl. América Latina hispânica)
NEXT_PUBLIC_PRICE_BRL=R$ 497
NEXT_PUBLIC_CHECKOUT_URL_BRL=

NEXT_PUBLIC_PRICE_EUR=
NEXT_PUBLIC_CHECKOUT_URL_EUR=

NEXT_PUBLIC_PRICE_USD=
NEXT_PUBLIC_CHECKOUT_URL_USD=

# Formulário curto antes do WhatsApp (todas as moedas).
# Webhook que recebe cada lead (nome, e-mail, telefone, UTMs, ids de clique,
# primeira/última visita, tempo na página, aparelho, IP e geolocalização).
# Só no servidor: a URL nunca vai pro navegador.
LEAD_WEBHOOK_URL=
# Opcional: enviado no header X-Webhook-Secret pra validar a origem.
LEAD_WEBHOOK_SECRET=
# WhatsApp comercial (só dígitos, com código do país). Padrão: 34624387902
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Número do Brasil (BRL). Vazio = usa o de cima.
NEXT_PUBLIC_WHATSAPP_NUMBER_BRL=

